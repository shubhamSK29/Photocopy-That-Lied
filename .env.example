# Storage locations (absolute paths; defaults sit inside the repository).
PTL_UPLOAD_DIR=
PTL_ARTIFACT_DIR=
PTL_REPORT_DIR=
PTL_MODEL_DIR=
PTL_DATASET_DIR=
PTL_DB_PATH=

# Upload limits.
PTL_MAX_FILE_SIZE_MB=25
PTL_MAX_PIXELS=50000000
PTL_MIN_DIMENSION=64

# Maximum dimension of the normalized analysis image.
PTL_ANALYSIS_MAX_DIM=1600

# Review bands (engineering defaults, tune on validation data).
PTL_BAND_LOW=30
PTL_BAND_HIGH=60

PTL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8000
